
#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    double a, b, c, D, x1, x2;

    cout << "Enter a, b, c: ";
    cin >> a >> b >> c;

    if (a == 0)
    {
        cout << "Not a quadratic equation";
    }
    else
    {
        D = b * b - 4 * a * c;

        if (D > 0)
        {
            x1 = (-b + sqrt(D)) / (2 * a);
            x2 = (-b - sqrt(D)) / (2 * a);

            cout << "x1 = " << x1 << endl;
            cout << "x2 = " << x2 << endl;
        }
        else if (D == 0)
        {
            x1 = -b / (2 * a);
            cout << "x = " << x1 << endl;
        }
        else
        {
            cout << "No real roots";
        }
    }

    return 0;
}
